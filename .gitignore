__pycache__/

# Terraform: everything local to a working directory. The provider lock file
# (.terraform.lock.hcl) is committed on purpose, and state lives in S3.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
