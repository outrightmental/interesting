{%- set labLinks = [
  ['index', 'index.html', 'home constellation'],
  ['constellation-diary', 'constellation-diary.html', 'constellation diary'],
  ['constellation-echo', 'constellation-echo.html', 'echo chamber'],
  ['constellation-weather', 'constellation-weather.html', 'weather lab'],
  ['orbital-weaver', 'orbital-weaver.html', 'orbital weaver'],
  ['sky-archive', 'sky-archive.html', 'sky archive oracle'],
  ['star-lantern', 'star-lantern.html', 'star lantern ritual'],
  ['wish-terrarium', 'wish-terrarium.html', 'wish terrarium']
] -%}
{%- set wayfindingLinks = [
  ['sitemap', 'sitemap.html', 'site map'],
  ['error', 'error.html', 'observatory 404']
] -%}
    <nav class='skyway' aria-label='Skyway navigation'>
      <p class='skyway-label'>skyway</p>
      <p class='skyway-note'>one saved sky, many instruments</p>

      <div class='skyway-grid'>
        <section class='skyway-group' aria-label='Constellation labs'>
          <p class='skyway-group-title'>constellation labs</p>
          <div class='skyway-links'>
{%- for link in labLinks %}
            <a href='{{ link[1] }}'{% if page and page.fileSlug == link[0] %} class='current' aria-current='page'{% endif %}>{{ link[2] }}</a>
{%- endfor %}
          </div>
        </section>

        <section class='skyway-group' aria-label='Wayfinding'>
          <p class='skyway-group-title'>wayfinding</p>
          <div class='skyway-links'>
{%- for link in wayfindingLinks %}
            <a href='{{ link[1] }}'{% if page and page.fileSlug == link[0] %} class='current' aria-current='page'{% endif %}>{{ link[2] }}</a>
{%- endfor %}
          </div>
        </section>
      </div>
    </nav>
