{#
  The row of links a page ends with. Which pages a page points at is part of what that page is, so
  the list stays in the page's own front matter as [href, text] pairs; the markup and the styling
  are shared, so a change to how the footer looks is one edit rather than ten.

      footer:
        - [index.html, back to constellation]
        - [sitemap.html, site map]
      footerNote: 'easter egg: tap the title five times'

  The constellation pages also share one loop of onward links, so they now get one federated
  circuit nav here rather than each carrying its own hand-written sky cluster.
#}
{%- set circuitSlugs = [
  'wish-constellation',
  'constellation-diary',
  'constellation-echo',
  'constellation-weather',
  'orbital-weaver',
  'sky-archive',
  'star-lantern',
  'wish-terrarium'
] -%}
{%- set circuitLinks = [
  ['wish-constellation', 'wish-constellation.html', 'wish constellation'],
  ['constellation-diary', 'constellation-diary.html', 'diary'],
  ['constellation-echo', 'constellation-echo.html', 'echo chamber'],
  ['constellation-weather', 'constellation-weather.html', 'weather lab'],
  ['orbital-weaver', 'orbital-weaver.html', 'orbital weaver'],
  ['sky-archive', 'sky-archive.html', 'archive oracle'],
  ['star-lantern', 'star-lantern.html', 'lantern ritual'],
  ['wish-terrarium', 'wish-terrarium.html', 'terrarium']
] -%}
{%- set inCircuit = page and (page.fileSlug in circuitSlugs) -%}
{%- if inCircuit %}
{%- set footerLinks = [
  ['index.html', 'back to the threshold'],
  ['moods.html', 'mood atlas'],
  ['sitemap.html', 'site map'],
  ['error.html', 'observatory 404']
] -%}
{%- else %}
{%- set footerLinks = footer or [] -%}
{%- endif %}
    <p class='footer'>
{%- for link in footerLinks %}
      <a class='action' href='{{ link[0] }}'>{{ link[1] }}</a>
{%- endfor %}
{%- if footerNote %}
      <span>{{ footerNote }}</span>
{%- endif %}
    </p>

{%- if inCircuit %}
    <section class='constellation-passport' aria-label='Constellation relay passport'>
      <p class='constellation-passport-title'>constellation relay passport</p>
      <p class='constellation-passport-status' id='constellation-passport-status'>Checking your saved sky…</p>
      <p class='constellation-passport-next' id='constellation-passport-next'>Each world in this circuit remixes the same saved stars.</p>
    </section>

    <nav class='footer-circuit' aria-label='Constellation circuit'>
      <p class='footer-circuit-label'>constellation circuit</p>
      <div class='footer-circuit-links'>
{%- for link in circuitLinks %}
        <a class='action' href='{{ link[1] }}'{% if page.fileSlug == link[0] %} aria-current='page'{% endif %}>{{ link[2] }}</a>
{%- endfor %}
      </div>
    </nav>
{%- endif %}
{%- if not (page and page.fileSlug == 'sitemap') %}
{% include 'wayfinding.njk' %}
{%- endif %}
