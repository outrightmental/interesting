{#
  The row of links a page ends with. Which pages a page points at is part of what that page is, so
  the list stays in the page's own front matter as [href, text] pairs; the markup and the styling
  are shared, so a change to how the footer looks is one edit rather than ten.

      footer:
        - [index.html, back to constellation]
        - [sitemap.html, site map]
      footerNote: 'easter egg: tap the title five times'

  The constellation pages also share one loop of onward links, so they now get one federated
  circuit nav here rather than each carrying its own hand-written sky cluster.
#}
{%- set circuitSlugs = [
  'wish-constellation',
  'constellation-diary',
  'constellation-echo',
  'constellation-weather',
  'orbital-weaver',
  'sky-archive',
  'star-lantern',
  'wish-terrarium'
] -%}
{%- set circuitLinks = [
  ['wish-constellation', 'wish-constellation.html', 'wish constellation'],
  ['constellation-diary', 'constellation-diary.html', 'diary'],
  ['constellation-echo', 'constellation-echo.html', 'echo chamber'],
  ['constellation-weather', 'constellation-weather.html', 'weather lab'],
  ['orbital-weaver', 'orbital-weaver.html', 'orbital weaver'],
  ['sky-archive', 'sky-archive.html', 'archive oracle'],
  ['star-lantern', 'star-lantern.html', 'lantern ritual'],
  ['wish-terrarium', 'wish-terrarium.html', 'terrarium']
] -%}
{%- set inCircuit = page and (page.fileSlug in circuitSlugs) -%}
{%- if inCircuit %}
{%- set footerLinks = [
  ['index.html', 'back to the threshold'],
  ['moods.html', 'mood atlas'],
  ['sitemap.html', 'site map'],
  ['error.html', 'observatory 404']
] -%}
{%- else %}
{%- set footerLinks = footer or [] -%}
{%- endif %}
    <p class='footer'>
{%- for link in footerLinks %}
      <a class='action' href='{{ link[0] }}'>{{ link[1] }}</a>
{%- endfor %}
{%- if footerNote %}
      <span>{{ footerNote }}</span>
{%- endif %}
    </p>

{%- if inCircuit %}
    <section class='constellation-passport' aria-label='Constellation relay passport'>
      <p class='constellation-passport-title'>constellation relay passport</p>
      <p class='constellation-passport-status' id='constellation-passport-status'>Checking your saved sky…</p>
      <p class='constellation-passport-next' id='constellation-passport-next'>Each world in this circuit remixes the same saved stars.</p>
      <div class='constellation-passport-meter' id='constellation-passport-meter' role='progressbar' aria-valuemin='0' aria-valuemax='8' aria-valuenow='0' aria-label='Constellation relay progress'>
        <div class='constellation-passport-fill' id='constellation-passport-fill'></div>
      </div>
      <p class='constellation-passport-count' id='constellation-passport-count'>0 of 8 relay worlds marked.</p>
      <div class='controls constellation-passport-controls'>
        <a class='action' id='constellation-passport-next-link' href='wish-constellation.html'>continue relay</a>
        <button id='constellation-passport-random' type='button'>random relay jump</button>
        <button id='constellation-passport-reset' type='button'>reset relay marks</button>
      </div>
    </section>

    <section class='constellation-quest' aria-label='Constellation relay quest'>
      <p class='constellation-quest-title'>relay quest terminal</p>
      <p class='constellation-quest-status' id='constellation-quest-status'>Preparing your next relay objective…</p>
      <p class='constellation-quest-objective' id='constellation-quest-objective'>The quest loop is optional. You can always roam anywhere.</p>
      <div class='controls constellation-quest-controls'>
        <a class='action' id='constellation-quest-link' href='wish-constellation.html'>open quest world</a>
        <button id='constellation-quest-complete' type='button'>mark quest complete</button>
        <button id='constellation-quest-reroll' type='button'>reroll quest</button>
      </div>
    </section>

    <section class='constellation-honors' aria-label='Constellation relay honors'>
      <p class='constellation-honors-title'>relay honors board</p>
      <p class='constellation-honors-status' id='constellation-honors-status'>No relay honors yet. Complete a full circuit to mint one.</p>
      <ol class='constellation-honors-list' id='constellation-honors-list'></ol>
      <div class='controls constellation-honors-controls'>
        <button id='constellation-honors-preview' type='button'>preview next honor</button>
        <button id='constellation-honors-clear' type='button'>clear honor board</button>
      </div>
    </section>

    <section class='constellation-remixer' aria-label='Constellation remixer'>
      <p class='constellation-remixer-title'>constellation remixer</p>
      <p class='constellation-remixer-status' id='constellation-remixer-status'>Loading remixer state…</p>
      <div class='controls constellation-remixer-controls'>
        <button id='constellation-remixer-shift' type='button'>remix one saved star</button>
        <button id='constellation-remixer-spark' type='button'>seed three sparks</button>
        <button id='constellation-remixer-undo' type='button'>undo last remix</button>
      </div>
    </section>

    <nav class='footer-circuit' aria-label='Constellation circuit'>
      <p class='footer-circuit-label'>constellation circuit</p>
      <div class='footer-circuit-links'>
{%- for link in circuitLinks %}
        <a class='action' href='{{ link[1] }}'{% if page.fileSlug == link[0] %} aria-current='page'{% endif %}>{{ link[2] }}</a>
{%- endfor %}
      </div>
    </nav>
{%- endif %}
{%- if not (page and page.fileSlug == 'sitemap') %}
{% include 'wayfinding.njk' %}
{%- endif %}
