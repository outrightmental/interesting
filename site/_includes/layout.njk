{# Front matter: title names the page; description describes it, or defaults to the world's description in _data/worlds.json. error.html uses inlineStyles and siteRoot because it can be served at an arbitrary missing path. A page supplies its main; the layout supplies navigation, persona and feed. siteRoot renders empty on every page that does not set it, so one block below serves both cases. #}
{%- set here = (page.filePathStem | replace('/', '')) + '.html' if page else '' %}
{%- set thisWorld = null %}
{%- for world in worlds.worlds %}{% if world.file == here %}{% set thisWorld = world %}{% endif %}{% endfor %}
{%- set icons = {
  'home': 'M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z',
  'explore': 'M12 10.9c-.61 0-1.1.49-1.1 1.1s.49 1.1 1.1 1.1c.61 0 1.1-.49 1.1-1.1s-.49-1.1-1.1-1.1zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm2.19 12.19L6 18l3.81-8.19L18 6l-3.81 8.19z',
  'map': 'M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z',
  'spark': 'M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z',
  'star': 'M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z',
  'shield': 'M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z',
  'page': 'M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z',
  'tune': 'M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z',
  'swap': 'M16 17.01V10h-2v7.01h-3L15 21l4-3.99h-3zM9 3L5 6.99h3V14h2V6.99h3L9 3z',
  'edit': 'M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z'
} %}
<!DOCTYPE html>
<html lang='en' data-page='{{ here }}'{% if thisWorld %} data-world='{{ thisWorld.mood }}'{% endif %}{% if siteRoot %} data-root='{{ siteRoot }}'{% endif %}>
<head>
  <meta charset='utf-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1'>
  <meta name='color-scheme' content='dark'>
  <title>{% if title %}{{ title }} · {% endif %}interesting</title>
  <link rel='icon' href='{{ siteRoot }}favicon.svg' type='image/svg+xml'>
  <script type='application/json' id='site-worlds'>{{ worlds.worlds | dump | safe }}</script>
{%- if description or thisWorld %}
  <meta name='description' content='{{ description if description else thisWorld.what }}'>
{%- endif %}
  <link rel='stylesheet' href='{{ siteRoot }}css/fonts.css'>
{%- if inlineStyles %}
  <style>{{ 'site' | css | safe }}{{ stylesheet | css | safe }}</style>
{%- else %}
  <link rel='stylesheet' href='{{ siteRoot }}css/site.css'>
{%- if stylesheet %}
  <link rel='stylesheet' href='{{ siteRoot }}css/{{ stylesheet }}.css'>
{%- endif %}
{%- endif %}
  <script src='{{ siteRoot }}js/analytics.js' defer></script>
  <script src='{{ siteRoot }}js/state.js'></script>
  <script src='{{ siteRoot }}js/motion.js'></script>
  <script src='{{ siteRoot }}js/participate.js' defer></script>
  <script src='{{ siteRoot }}js/persona.js'></script>
  <script src='{{ siteRoot }}js/site.js'></script>
  <script src='{{ siteRoot }}js/threshold.js' defer></script>
  <script src='{{ siteRoot }}js/feed.js' type='module'></script>
  <script src='{{ siteRoot }}js/stage.js' type='module'></script>
</head>
<body>
  <a class='skip-link' href='#main-content'>skip to main content</a>
  {# The one veil the whole site goes behind: window.interestingSite.lightbox() in js/site.js raises it, _sass/_lightbox.scss paints it, and the sparkles logo's constellation, the persona sheet and the "are you sure?" modal all open through it (issue #70). Hidden until a script raises it, so a visitor with none gets no dimming they could not dismiss. #}
  <div class='lightbox-veil' id='lightbox-veil' hidden></div>
  <details class='sparknav' id='sparknav'>
    <summary class='sparknav-logo' id='sparknav-logo' aria-label='interesting: the site menu'>
      <svg class='icon sparknav-spark' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='{{ icons.spark }}'/></svg>
      <span class='sparknav-name'>interesting</span>
    </summary>
    <nav class='sparknav-sky' aria-label='Site'>
      <ul class='sparknav-orbit sparknav-near' id='sparknav-near'>
{%- for link in worlds.wayIn %}
        <li class='sparknav-option'>
          <span class='sparknav-ray' aria-hidden='true'></span>
          <a class='sparknav-node' href='{{ siteRoot }}{{ link.file }}'{% if here == link.file %} aria-current='page'{% endif %}>
            <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='{{ icons[link.icon] }}'/></svg>
            <span class='sparknav-words'><span class='sparknav-label'>{{ link.name }}</span><span class='sparknav-gloss'>{{ link.gloss }}</span></span>
          </a>
        </li>
{%- endfor %}
        <li class='sparknav-option' id='sparknav-reading' hidden>
          <span class='sparknav-ray' aria-hidden='true'></span>
          <a class='sparknav-node' id='sparknav-reading-go' href='{{ siteRoot }}moods.html'>
            <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='{{ icons.star }}'/></svg>
            <span class='sparknav-words'><span class='sparknav-label' id='sparknav-reading-label'>the mood atlas</span><span class='sparknav-gloss' id='sparknav-reading-gloss' hidden></span></span>
          </a>
        </li>
      </ul>
      <ul class='sparknav-orbit sparknav-far' id='sparknav-far'>
        <li class='sparknav-option' id='sparknav-participate' hidden>
          <span class='sparknav-ray' aria-hidden='true'></span>
          <button type='button' class='sparknav-node' id='sparknav-participate-open'>
            <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='{{ icons.edit }}'/></svg>
            <span class='sparknav-label'>change this site</span>
          </button>
        </li>
        <li class='sparknav-option' id='sparknav-cookies' hidden>
          <span class='sparknav-ray' aria-hidden='true'></span>
          <button type='button' class='sparknav-node' id='sparknav-cookies-open' aria-haspopup='dialog'>
            <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='{{ icons.tune }}'/></svg>
            <span class='sparknav-label'>cookies</span>
          </button>
        </li>
        <li class='sparknav-option' id='sparknav-state' hidden>
          <span class='sparknav-ray' aria-hidden='true'></span>
          <button type='button' class='sparknav-node' id='sparknav-state-open' aria-haspopup='dialog'>
            <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='{{ icons.swap }}'/></svg>
            <span class='sparknav-label' id='sparknav-state-label'>state</span>
          </button>
        </li>
{%- for link in worlds.finePrint %}
        <li class='sparknav-option'>
          <span class='sparknav-ray' aria-hidden='true'></span>
          <a class='sparknav-node' href='{{ siteRoot }}{{ link.file }}'{% if here == link.file %} aria-current='page'{% endif %}>
            <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='{{ icons[link.icon] }}'/></svg>
            <span class='sparknav-words'><span class='sparknav-label'>{{ link.name }}</span><span class='sparknav-gloss'>{{ link.gloss }}</span></span>
          </a>
        </li>
{%- endfor %}
      </ul>
    </nav>
    <div class='sparknav-modal' id='sparknav-modal' hidden></div>
  </details>
  <div class='persona' id='persona' data-state='empty' data-sky='none' data-reading='none' data-asking='false' data-difficulty='fair'>
    <p class='persona-text visually-hidden' id='persona-text'>No persona yet.</p>
    <button type='button' class='persona-avatar' id='persona-open' aria-haspopup='dialog' aria-controls='persona-sheet' aria-describedby='persona-text' hidden>
      <span class='persona-portrait' aria-hidden='true'><canvas id='persona-portrait' width='40' height='40'></canvas></span>
      <span class='persona-label'>set up persona</span>
    </button>
  </div>
  <div id='main-content' tabindex='-1'>{{ content | safe }}</div>
  <div class='page'>
{% include 'worlds.njk' %}
  </div>
  <dialog class='persona-sheet' id='persona-sheet' role='dialog' aria-modal='true' aria-labelledby='persona-sheet-title'>
    <div class='persona-sheet-head'>
      <h2 id='persona-sheet-title' class='persona-sheet-title'>your persona</h2>
      <button type='button' class='persona-close btn-text' id='persona-close'>close</button>
    </div>
    <p class='panel-note persona-sheet-intro'>Your persona travels with you in the portrait: a sky of thoughts, a reading from one sideways answer, and one difficulty for every puzzle. Change the sky here to see what puzzles make of it; the reading suggests where to begin. These settings stay in this browser.</p>
    <section class='persona-section' aria-labelledby='persona-sky-title'>
      <h3 id='persona-sky-title' class='panel-label'>constellation</h3>
      <p class='panel-note'>Tap the sky to add a star. Choose one to change its words; drag it or use its arrow keys to move it. Once there are two, follow the numbered path of nearby thoughts. Choose a different star to start elsewhere; moving a star changes the path and the sky's name. A few shapes have names of their own. The marks under the sky name them: the one your sky makes is lit, and pressing a mark says how to make it and how close you are. Your portrait wears a ring once you find one.</p>
      <div class='persona-sky' id='persona-sky'><canvas class='persona-sky-canvas' aria-hidden='true'></canvas></div>
      <p class='persona-sky-name' id='persona-sky-name' hidden></p>
      <p class='persona-thread' id='persona-thread' aria-live='polite' hidden></p>
      <div class='persona-figures' id='persona-figures' role='group' aria-label='the named shapes'></div>
      <form class='persona-star-words' id='persona-star-words' hidden>
        <label for='persona-star-thought'>what this star carries (up to 160 characters)</label>
        <input id='persona-star-thought' type='text' maxlength='160' required autocomplete='off'>
        <button type='submit'>keep these words</button>
        <p class='panel-note' id='persona-star-neighbor' aria-live='polite'></p>
      </form>
      <div class='controls'>
        <button id='persona-drop' type='button'>drop a star</button>
        <button id='persona-seed' type='button'>seed a small sky</button>
        <button id='persona-remove' type='button' hidden>remove this star</button>
        <button id='persona-clear' type='button' class='warning'>clear the sky</button>
      </div>
      <p class='panel-status' id='persona-sky-status' aria-live='polite'></p>
      <div class='persona-sky-answer' id='persona-sky-answer' hidden>
        <p class='panel-note' id='persona-sky-answer-note'>Preview a puzzle made from your stars, then move a star or change its words to compare what happens.</p>
        <p class='persona-sky-answer-world' id='persona-sky-answer-world' hidden></p>
        <h4 class='persona-sky-answer-title' id='persona-sky-answer-title' hidden></h4>
        <button class='persona-sky-read btn-text' id='persona-sky-read' type='button' aria-describedby='persona-sky-answer-note persona-sky-answer-title persona-sky-answer-line'>
          <span class='persona-sky-preview' id='persona-sky-preview' hidden><canvas id='persona-sky-preview-canvas' aria-hidden='true'></canvas></span>
          <span id='persona-sky-read-label'>preview a puzzle</span>
        </button>
        <p class='panel-status' id='persona-sky-answer-line' aria-live='polite'></p>
        <details class='persona-sky-comparison' id='persona-sky-comparison' hidden>
          <summary>compare with the first preview</summary>
          <div class='persona-sky-before'>
            <p class='panel-note' id='persona-sky-before-change'></p>
            <p class='persona-sky-answer-title' id='persona-sky-before-title'></p>
            <span class='persona-sky-preview' id='persona-sky-before-picture' hidden><canvas id='persona-sky-before-canvas' aria-hidden='true'></canvas></span>
            <p class='panel-status' id='persona-sky-before-line'></p>
          </div>
        </details>
      </div>
    </section>
    <section class='persona-section' aria-labelledby='persona-reading-title'>
      <h3 id='persona-reading-title' class='panel-label'>reading</h3>
      <p class='panel-status' id='persona-reading'></p>
      <div class='controls persona-reading-actions'>
        <a class='action' id='persona-ask' href='{{ siteRoot }}index.html'>the threshold</a>
        <button id='persona-forget' type='button' class='warning' hidden>forget my reading</button>
        <a class='action' id='persona-reading-go' href='{{ siteRoot }}moods.html' hidden>the mood atlas</a>
      </div>
      <div class='persona-probe' id='persona-sheet-probe' hidden></div>
      <p class='panel-note'>Your stars do not change this reading. A puzzle you have begun keeps its clues when you change the sky. <a href='{{ siteRoot }}moods.html'>the mood atlas</a> shows where each reading can lead.</p>
    </section>
    {# The third setting, named as plainly as the constellation (issue #93): one slider for how hard
       every puzzle on the site comes out. js/persona.js renders the control into the host below --
       the same one js/stage.js puts beside the piece it is dealing, so the setting is settable
       wherever it is a dependency and there is only ever one slider to learn. #}
    <section class='persona-section' aria-labelledby='persona-difficulty-title'>
      <h3 id='persona-difficulty-title' class='panel-label'>difficulty</h3>
      <p class='panel-note'>One setting for every puzzle on this site: how many hints a piece will give you when you ask, and how close a measured answer has to be. The same slider stands beside every piece, so you can change your mind there.</p>
      <div class='persona-difficulty' id='persona-difficulty'></div>
    </section>
  </dialog>
</body>
</html>
