{%- set stageEntry = null -%}
{%- for world in worlds.worlds %}{% if world.file == stageWorld + '.html' %}{% set stageEntry = world %}{% endif %}{% endfor -%}
<main class='stage{% if threshold %} stage-threshold{% endif %}' id='stage' data-mode='{% if threshold %}quiet{% else %}idle{% endif %}'{% if stageEntry %} data-stage-world='{{ stageWorld }}'{% endif %}{% if threshold %} data-threshold='true'{% endif %}{% if stageRandom %} data-stage-random='true'{% endif %}>
  <canvas class='stage-burst' id='stage-burst' aria-hidden='true'></canvas>
  <div class='stage-inner' id='stage-inner'>
    <div class='stage-head' id='stage-head'>
      <h1 class='stage-world' id='stage-world'>{{ stageEntry.name if stageEntry else title }}</h1>
{%- if threshold %}
      <p class='stage-read' id='stage-read' hidden></p>
      <h2 class='stage-title' id='stage-title' tabindex='-1'>Answer one question about a door, a stone or a mark to open a world you can play and finish, or choose a world below.</h2>
{%- else %}
{%- if stageRead %}
      <p class='stage-read' id='stage-read'>{{ stageRead }}</p>
{%- endif %}
      <h2 class='stage-title' id='stage-title' tabindex='-1'>{{ stageLine if stageLine else (stageEntry.what if stageEntry else '') }}</h2>
{%- endif %}
      <p class='stage-brief' id='stage-brief'></p>
    </div>
{%- if threshold %}
    <div class='stage-ask' id='stage-ask'>
      <div class='controls' id='threshold-controls' hidden>
        <button type='button' class='btn-filled' id='threshold-ask'>ask me</button>
        <button type='button' class='btn-text' id='threshold-skip'>skip the question</button>
      </div>
      <div class='persona-probe threshold-probe' id='persona-probe' hidden></div>
    </div>
{%- endif %}
    <div class='stage-body' id='stage-body'>
      <div class='stage-scene' id='stage-scene'>
        <canvas class='stage-canvas' id='stage-canvas' role='img' aria-label='the scene'></canvas>
        <div class='stage-done' id='stage-done' hidden>
          <span class='stage-done-mark' aria-hidden='true'><svg class='icon' viewBox='0 0 24 24' focusable='false'><path d='M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z'/></svg></span>
          <p class='stage-done-text' id='stage-done-text'>done</p>
        </div>
      </div>
      <div class='stage-side'>
        <div class='stage-knobs' id='stage-knobs'></div>
        <p class='stage-status' id='stage-status' aria-live='polite'></p>
        <p class='stage-wanted' id='stage-wanted' aria-live='polite' hidden></p>
        <div class='stage-foot'>
          {#- Kept even when it is empty: the dots sit at the right of this row, and they stay
              there whether or not the threshold's own button is standing opposite them. -#}
          <div class='stage-foot-actions'>
{%- if threshold %}
            <button type='button' class='btn-text' id='stage-again' hidden>ask another way</button>
{%- endif %}
          </div>
          <div class='stage-progress' id='stage-progress'></div>
        </div>
      </div>
    </div>
  </div>
  {#- The way on, pinned in the lower right of the viewport: dim for the whole piece and lit the
      moment it is finished, so nothing moves on until the visitor says so (issue #78). Outside
      #stage-inner on purpose -- the vanish transforms that box, and a transformed ancestor is
      what a fixed child would be positioned against -- so this mark holds still in the same
      corner whatever the piece's shape, however many knobs it has, and whichever piece is on. -#}
  <button type='button' class='stage-next' id='stage-next' aria-label='the next piece' disabled>
    <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='M6.41 6L5 7.41 9.58 12 5 16.59 6.41 18l6-6zm6.59 0l-1.41 1.41L16.17 12l-4.58 4.59L13 18l6-6z'/></svg>
  </button>
</main>
