{# The stage's name (its h1) and first line (its h2) are its page's one entry in _data/worlds.json -- a world from worlds, the threshold from wayIn, the 404 from edges -- as the layout's title is, so a page is called the same thing everywhere. A world's entry (one with a mood) also writes data-stage-world. The 404 adds one plain line of its own over the title, as stageRead. #}
{%- set stageFile = (page.filePathStem | replace('/', '')) + '.html' -%}
{%- set stagePage = null -%}
{%- for list in [worlds.worlds, worlds.wayIn, worlds.edges] %}{% for entry in list %}{% if entry.file == stageFile %}{% set stagePage = entry %}{% endif %}{% endfor %}{% endfor -%}
{%- set stageEntry = stagePage if stagePage and stagePage.mood else null -%}
<main class='stage{% if threshold %} stage-threshold{% endif %}' id='stage' data-mode='{% if threshold %}quiet{% else %}idle{% endif %}'{% if stageEntry %} data-stage-world='{{ stageEntry.file | replace('.html', '') }}'{% endif %}{% if threshold %} data-threshold='true'{% endif %}{% if stageRandom %} data-stage-random='true'{% endif %}>
  <div class='stage-inner' id='stage-inner'>
    <div class='stage-head' id='stage-head'>
      <h1 class='stage-world' id='stage-world'>{{ stagePage.name if stagePage else title }}</h1>
      {# The sigil: the working's number, beside the world's name, which is the seed in the piece's own
         address. js/stage.js writes it when a piece begins and takes it away with the piece; it is
         hidden until then, so the threshold at rest and a page without scripting show none. #}
      <p class='stage-sigil' id='stage-sigil' hidden></p>
{%- if threshold %}
      <p class='stage-read' id='stage-read' hidden></p>
{%- elif stageRead %}
      <p class='stage-read' id='stage-read'>{{ stageRead }}</p>
{%- endif %}
      <h2 class='stage-title' id='stage-title' tabindex='-1'>{{ stagePage.what if stagePage else '' }}</h2>
      <p class='stage-brief' id='stage-brief'></p>
      {# The goal: one line that says what counts as solved. A puzzle without one is a toy, so js/stage.js
         shows it for every piece that states one and hides it only while nothing is on. #}
      <p class='stage-goal' id='stage-goal' hidden><span class='stage-goal-word'>the goal</span> <span class='stage-goal-text' id='stage-goal-text'></span></p>
    </div>
{%- if threshold %}
    <div class='stage-ask' id='stage-ask'>
      <div class='controls' id='threshold-controls' hidden>
        <label for='threshold-way'>way of asking</label>
        <select id='threshold-way'><option value=''>any way</option></select>
        <button type='button' class='btn-filled' id='threshold-ask'>ask me</button>
        <button type='button' class='btn-text' id='threshold-skip'>skip the question</button>
      </div>
      <div class='persona-probe threshold-probe' id='persona-probe' hidden></div>
    </div>
{%- endif %}
    <div class='stage-body' id='stage-body'>
      <div class='stage-scene' id='stage-scene'>
        <canvas class='stage-canvas' id='stage-canvas' role='img' aria-label='the scene'></canvas>
      </div>
      <div class='stage-side'>
        <div class='stage-knobs' id='stage-knobs'></div>
        {# The check: the one way a puzzle is finished. Enabled once every knob is set; a press is a try,
           and the line beside it keeps the score (js/stage.js, judge()). #}
        <div class='stage-check-row'>
          <button type='button' class='btn-filled stage-check' id='stage-check' disabled>check</button>
          <p class='stage-tries' id='stage-tries' aria-live='polite' hidden></p>
        </div>
        <p class='stage-status' id='stage-status' aria-live='polite'></p>
        <p class='stage-wanted' id='stage-wanted' aria-live='polite' hidden></p>
        <div class='stage-foot'>
          <div class='stage-foot-actions'>
{%- if threshold %}
            <button type='button' class='btn-text' id='stage-again' hidden>ask another way</button>
{%- endif %}
          </div>
          {# Done is reported here, beside the dots, and never over the scene: a piece that is Done has
             not Ended, so the picture stays the visitor's to go on playing with (issue #86). #}
          <div class='stage-foot-end'>
            <p class='stage-done' id='stage-done' hidden>
              <span class='stage-done-mark' aria-hidden='true'><svg class='icon' viewBox='0 0 24 24' focusable='false'><path d='M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z'/></svg></span>
              <span class='stage-done-text' id='stage-done-text'>done</span>
            </p>
            <div class='stage-progress' id='stage-progress'></div>
          </div>
        </div>
        {# The difficulty every piece is dealt at, settable where it is a dependency (issue #93).
           js/persona.js keeps the setting and renders the one slider into this host; js/stage.js
           mounts it and deals this piece again whenever it moves, so the visitor does not have to
           open the persona sheet to change their mind about the puzzle in front of them. #}
        <div class='stage-difficulty' id='stage-difficulty'></div>
      </div>
    </div>
  </div>
  {# The way on: the one mark that sends a piece away and opens the next card in its place. It is
     never disabled (issue #109) -- a visitor can leave a puzzle unsolved -- but it is dim until a
     piece is finished, when js/stage.js lights it (data-lit). The stage never moves on by itself:
     the press of this is the only thing that does. #}
  <button type='button' class='stage-next' id='stage-next' aria-label='the next piece'>
    <svg class='icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='M6.41 6L5 7.41 9.58 12 5 16.59 6.41 18l6-6zm6.59 0l-1.41 1.41L16.17 12l-4.58 4.59L13 18l6-6z'/></svg>
  </button>
</main>
